# ==============================================================================
# ProjectMind Platform — Environment Configuration Example (.env.example)
# ==============================================================================
# Copy this file to .env or inject these variables into your deployment container.
# NEVER commit real credentials, passwords, or secret tokens into source control.
# ==============================================================================

# --- Application Configuration ---
PROJECTMIND_ENV=development                        # Environment: development | test | production
PROJECTMIND_APP_NAME=projectmind                   # Service name identifier
PROJECTMIND_APP_VERSION=1.0.0                      # Application release version
PROJECTMIND_LOG_LEVEL=INFO                         # Logging verbosity: DEBUG | INFO | WARN | ERROR | FATAL

# --- Production Agent Runtime ---
PROJECTMIND_RUNTIME_ENABLED=true                   # Enable the closed-loop production agent runtime
PROJECTMIND_MAX_SESSIONS=10                        # Maximum concurrent active agent sessions
PROJECTMIND_MAX_TASKS=20                           # Maximum concurrent active agent tasks
PROJECTMIND_SESSION_TIMEOUT_MS=3600000             # Session inactivity TTL (1 hour)
PROJECTMIND_TASK_TIMEOUT_MS=1800000                # Task execution timeout (30 minutes)
PROJECTMIND_TOOL_TIMEOUT_MS=30000                  # Maximum tool execution timeout (30 seconds)
PROJECTMIND_CONTEXT_TIMEOUT_MS=30000               # Context retrieval timeout (30 seconds)
PROJECTMIND_RECOVERY_TIMEOUT_MS=60000              # State recovery timeout (60 seconds)
PROJECTMIND_SHUTDOWN_TIMEOUT_MS=15000              # Maximum graceful shutdown drain time (15 seconds)
PROJECTMIND_CONTEXT_REFRESH_POLICY=ON_NEXT_REQUEST # Policy: IMMEDIATE | ON_NEXT_REQUEST | LAZY | MANUAL

# --- Deployment Role & Server ---
PROJECTMIND_ROLE=all                               # Runtime role: api | worker | scheduler | migration | all
PORT=3000                                          # HTTP API and probe listener port
HOST=0.0.0.0                                       # HTTP listener host binding
PROJECTMIND_CORS_ORIGINS=*                         # Allowed CORS origins (comma-separated)
PROJECTMIND_REQUEST_TIMEOUT_MS=30000               # HTTP request timeout (30 seconds)
PROJECTMIND_DRAIN_TIMEOUT_MS=10000                 # Graceful connection drain timeout (10 seconds)

# --- Durable Worker Infrastructure ---
PROJECTMIND_WORKER_CONCURRENCY=5                   # Concurrent durable job worker slots
PROJECTMIND_POLL_INTERVAL_MS=250                   # Worker queue polling interval in ms
PROJECTMIND_VISIBILITY_TIMEOUT_MS=30000            # Worker lease visibility timeout in ms
PROJECTMIND_LEASE_RENEWAL_INTERVAL_MS=10000        # Worker lease heartbeat renewal in ms

# --- Distributed Coordination & Caching ---
PROJECTMIND_CACHE_ENABLED=true                     # Enable caching layer
PROJECTMIND_CACHE_TYPE=memory                      # Cache backend: memory | sqlite | redis
PROJECTMIND_CACHE_MAX_MB=1024                      # Maximum in-memory cache allocation (1024 MB)
PROJECTMIND_CACHE_TTL_MS=3600000                   # Default cache entry TTL (1 hour)
PROJECTMIND_REDIS_ENABLED=false                    # Enable Redis for distributed locking/coordination
# PROJECTMIND_REDIS_URL=redis://localhost:6379       # Redis connection string
PROJECTMIND_REDIS_KEY_PREFIX=projectmind:          # Namespace prefix for distributed keys

# --- Storage & Database Infrastructure ---
PROJECTMIND_STORAGE_TYPE=memory                    # Storage backend: memory | sqlite | filesystem
PROJECTMIND_STORAGE_LOCATION=.projectmind/data     # Persistence directory path (required for SQLite/filesystem)
# PROJECTMIND_DATABASE_URL=sqlite://.projectmind/data/projectmind.db # Optional connection string
PROJECTMIND_DATABASE_WAL=true                      # Enable SQLite Write-Ahead Logging (WAL)
PROJECTMIND_DATABASE_BUSY_TIMEOUT_MS=5000          # SQLite busy timeout for concurrent access (ms)
PROJECTMIND_AUTO_MIGRATE=true                      # Auto-apply schema migrations on startup
PROJECTMIND_MAX_PAYLOAD_BYTES=10485760             # Maximum incoming request payload size (10 MB)

# --- Observability & Telemetry ---
PROJECTMIND_LOG_FORMAT=json                        # Output format: json | pretty
PROJECTMIND_TELEMETRY_ENABLED=true                 # Enable operational telemetry and latency tracking
PROJECTMIND_METRICS_ENABLED=true                   # Enable bounded metric aggregation
PROJECTMIND_SECRET_REDACTION_ENABLED=true          # Enable pre-log sanitization of tokens & credentials

# --- Agent & Adapters ---
PROJECTMIND_AGENT_RUNTIME_ENABLED=true             # Enable external agent coordination
PROJECTMIND_ADAPTERS_ENABLED=true                  # Enable provider-neutral adapters (MCP, Generic, CLI)
# PROJECTMIND_DEFAULT_ADAPTER_ID=mcp               # Optional default adapter ID

# --- Security & Boundaries ---
PROJECTMIND_ALLOW_UNSAFE_DEV_DEFAULTS=false        # Must remain false in production environments
PROJECTMIND_AUTH_MODE=none                         # Authentication mode: none | token | mtls
# PROJECTMIND_MASTER_KEY=                          # Master encryption key (REQUIRED in production: min 32 chars / 256 bits)
# PROJECTMIND_API_KEY=placeholder-api-key           # API token when authMode is token
# PROJECTMIND_SESSION_SECRET=placeholder-secret     # Session encryption secret


